@@ -9548,8 +9548,17 @@ fn compute_tac_leading_width(
             }
             Some(_) => break,
             None => {
-                // block 취급 TAC: 전체 run 합산
-                width += estimate_text_width(effective_full, &style);
+                // block 취급 TAC: 전체 run 합산.
+                //
+                // 단 탭(U+0009)만으로 이루어진 run 은 제외한다. 이 분기가 노리는
+                // 것은 한컴이 표 폭만큼 채워 넣은 *필러*(U+F081C 등 PUA)이고,
